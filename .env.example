# --- server only; never ship to the widget ---
DATABASE_URL=postgres://askdocs:askdocs@localhost:5433/askdocs
PORT=8787

# required: answers (and the eval judge when OPENAI_API_KEY is empty)
ANTHROPIC_API_KEY=
# optional: only needed for EMBED_MODEL=text-embedding-* or JUDGE_MODEL=gpt-*
OPENAI_API_KEY=

# optional: tracing is a no-op when unset
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# admin key for POST /ingest (any long random string)
ADMIN_KEY=change-me
# secret used to HMAC IPs / user ids in traces
TRACE_HASH_SECRET=change-me-too

# demo site (seeded by migrate)
DEMO_SITE_TOKEN=pk_demo_vuejs
DEMO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

ANSWER_MODEL=claude-opus-5
# faithfulness judge; default claude-sonnet-5. gpt-5-mini gives a cross-family judge (needs OpenAI credits)
#JUDGE_MODEL=gpt-5-mini
# embeddings: local ONNX by default (no key). Alternatives: text-embedding-3-small (OpenAI, 1536)
EMBED_MODEL=Xenova/bge-small-en-v1.5
# only needed for a model not in the built-in dimension table
#EMBED_DIM=384
ASK_DOCS_VERSION=it1
